# Server configuration
server:
  port: 8080
  host: "127.0.0.1"
  # Leave this out and the client measures how many requests this GPU can
  # hold. Set a number (1 or more) only to override that; there is no
  # unlimited.
  # max_concurrent_inference: 4
  # How many returning turns of conversations may wait for a free slot.
  # Beyond this a turn is refused at once and Flockadoo sends it elsewhere.
  # session_queue_limit: 32

# Provider configuration
provider:
  # Your provider API key from the Flockadoo platform
  api_key: "your_api_key_here"
  # URL of the central Flockadoo system.
  url: "https://core.flockadoo.ai"
  # Local engine: vllm, vllm-metal, or llama_cpp (empty means vllm).
  # Re-run `flockadoo setup` to change this.
  # engine: "vllm"
  # engine_bin: ""  # absolute path when the binary is not on PATH
  llm_url: "http://127.0.0.1:8000"
  # model: "Qwen/Qwen2.5-7B-Instruct"
  # auto_start: true  # start the engine if llm_url is down
  # Models are downloaded to, served from and verified in the Hugging Face cache
  # (~/.cache/huggingface/hub, e.g. models--Qwen--Qwen3-0.6B/snapshots/<commit>).
  # To use another folder, set HF_HUB_CACHE in the client's environment.
  # Optional override:
  # model_path: /home/ubuntu/models/Qwen3-0.6B  # flat dir from hf download --local-dir

# Logging configuration
logging:
  # Log level: debug, info, warn, error
  level: "info"
  # Log directory (defaults to ~/.local/state/flockadoo/log if empty)
  log_dir: ""
  # Maximum size of log files in megabytes before rotation
  max_size: 100
  # Maximum number of old log files to retain
  max_backups: 5
  # Maximum number of days to retain old log files
  max_age: 30 